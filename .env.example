# --- CrossWave Hybrid · Configurazione ambiente ---
# Copia questo file in ".env" e inserisci i valori reali.
# Il file .env NON deve finire in git (è la tua configurazione privata).

# Chiave di firma della sessione Flask (cambiala in produzione)
SECRET_KEY=cambia_questa_chiave_segreta

# Porta del server (default 5002)
PORT=5002

# Debug/reloader Flask: 0 per disattivare il reloader in produzione
FLASK_DEBUG=0
