# --- CrossWave Hybrid · Configurazione ambiente ---
# Copia questo file in ".env" e inserisci i valori reali.
# Il file .env NON deve finire in git (è la tua configurazione privata).

# Chiave di firma della sessione Flask (cambiala in produzione)
SECRET_KEY=cambia_questa_chiave_segreta

# Porta del server (default 5002)
PORT=5002

# Debug/reloader Flask: 0 per disattivare il reloader in produzione
FLASK_DEBUG=0

# --- Raccomandazioni "Per te" (Fase 1) ---
# Chiave API Last.fm (https://www.last.fm/api): abilita la modalità "Vicino".
# Senza chiave la fonte Last.fm è disattivata (degrado silenzioso).
LASTFM_API_KEY=

# User-Agent identificativo per MusicBrainz (obbligatorio dalle loro policy).
# Formato consigliato: NomeApp/versione (contatto)
MB_USER_AGENT=CrossWave/0.1 (+https://github.com/bubeeh/crosswave-testing)
